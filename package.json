{
  "name": "sigilla",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:widget && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:vector": "tsx scripts/db-vector.ts",
    "db:vector:index": "tsx scripts/db-vector.ts --index",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "build:widget": "tsc -p widget/tsconfig.json && node widget/build.mjs",
    "size": "npm run build:widget && size-limit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "check": "npm run lint && npm run typecheck && npm run test && npm run size"
  },
  "size-limit": [
    {
      "path": "public/widget/v1.js",
      "limit": "5 KB"
    }
  ],
  "dependencies": {
    "@better-auth/api-key": "^1.7.7",
    "@google/genai": "^2.29.1",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@langchain/core": "^1.2.17",
    "@langchain/textsplitters": "^1.0.2",
    "@napi-rs/canvas": "^1.0.11",
    "@notionhq/client": "^5.27.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.2",
    "@vercel/blob": "^2.8.1",
    "better-auth": "^1.7.7",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "groq-sdk": "^1.6.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-toastify": "^11.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@size-limit/file": "^14.2.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.4",
    "dotenv": "^18.0.7",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "pdfkit": "^0.20.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "serve": "^14.2.6",
    "size-limit": "^14.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.4"
  }
}
