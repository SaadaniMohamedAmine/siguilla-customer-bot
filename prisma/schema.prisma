
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]

  // --- Billing (Stripe, test mode) — Phase 6 ---
  plan                     String    @default("free") // free | pro | team
  stripeCustomerId         String?   @unique
  stripeSubscriptionId     String?   @unique
  stripeSubscriptionStatus String?
  messageCount             Int       @default(0)
  usagePeriodStart         DateTime  @default(now())
  isDemo                   Boolean   @default(false)

  chatbots         Chatbot[]
  notionConnection NotionConnection?

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Apikey {
  id                  String    @id
  configId            String    @default("default")
  name                String?
  start               String?
  referenceId         String
  prefix              String?
  key                 String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true)
  rateLimitTimeWindow Int?      @default(86400000)
  rateLimitMax        Int?      @default(10)
  requestCount        Int?      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?

  @@index([configId])
  @@index([referenceId])
  @@index([key])
  @@map("apikey")
}

model Chatbot {
  id                  String           @id @default(cuid())
  organizationId      String
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  instructions        String?          @db.Text
  publicKey           String           @unique // pk_xxx — exposé dans le snippet du widget
  allowedDomains      String[]         @default([])
  similarityThreshold Float            @default(0.75)
  widgetConfig        Json             @default("{}")
  status              String           @default("draft") // draft | live
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  dataSources         DataSource[]
  chunks              Chunk[]
  conversations       Conversation[]
  events              AnalyticsEvent[]

  @@index([organizationId])
}

model DataSource {
  id            String    @id @default(cuid())
  chatbotId     String
  chatbot       Chatbot   @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  type          String // pdf | url | notion
  name          String
  url           String? // url: point d'entrée du crawl ; pdf: null
  blobUrl       String? // pdf
  blobPathname  String?
  notionPageIds String[]  @default([])
  status        String    @default("queued") // queued | processing | ready | failed
  progress      Json      @default("{}") // { done, total, phase } pour l'UI
  cursor        Json      @default("{}") // état interne des lots enchaînés
  pagesCount    Int       @default(0)
  chunksCount   Int       @default(0)
  contentHash   String?
  lastSyncedAt  DateTime?
  error         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  chunks        Chunk[]

  @@index([chatbotId])
}

model Chunk {
  id           String                      @id @default(cuid())
  dataSourceId String
  dataSource   DataSource                  @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  chatbotId    String
  chatbot      Chatbot                     @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  content      String                      @db.Text
  embedding    Unsupported("vector(768)")?
  sourceTitle  String
  sourceUrl    String?
  pageNumber   Int?
  contentHash  String
  createdAt    DateTime                    @default(now())

  @@index([chatbotId])
  @@index([dataSourceId])
  @@unique([dataSourceId, contentHash])
}

model NotionConnection {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accessTokenEnc String       @db.Text // AES-256-GCM (iv:tag:ciphertext, base64)
  workspaceId    String
  workspaceName  String?
  workspaceIcon  String?
  createdAt      DateTime     @default(now())
}

model Conversation {
  id             String    @id @default(cuid())
  chatbotId      String
  chatbot        Chatbot   @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  visitorId      String
  status         String    @default("bot") // bot | handoff_requested | human | resolved
  visitorEmail   String?
  pageUrl        String?
  locale         String?
  country        String? // depuis l'en-tête x-vercel-ip-country, jamais l'IP
  agentName      String? // nom de l'humain qui a repris
  fallbackStreak Int       @default(0)
  lastMessageAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  messages       Message[]

  @@index([chatbotId, lastMessageAt])
  @@index([chatbotId, status])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // visitor | bot | agent | system
  content        String       @db.Text
  citations      Json         @default("[]") // [{ index, chunkId, title, url, pageNumber, score }]
  topScore       Float?
  fallback       Boolean      @default(false)
  provider       String? // groq | gemini
  feedback       String? // up | down
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  chatbotId String
  chatbot   Chatbot  @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  type      String // widget_open | message | feedback | handoff | fallback
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([chatbotId, type, createdAt])
}

model RateLimitBucket {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}
